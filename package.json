{
  "name": "openjarvis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenJarvis — personal AI assistant with Cloud and Offline modes, plus a native Android app for real phone control.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist-server/server.mjs",
    "build": "node scripts/build.mjs all",
    "build:web": "node scripts/build.mjs web",
    "build:server": "node scripts/build.mjs server",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node tests/backend.test.mjs && node tests/download.test.mjs && node tests/lan-lowmem.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "manifest": "node scripts/gen-manifest.mjs",
    "clean": "rm -rf dist dist-server"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
