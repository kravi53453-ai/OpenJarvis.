# Copy to .env (optional). Everything here can also be set inside the app (Menu → Providers).
# Keys saved in the app live in data/keys.json (file mode 0600). Leave blank to use the app instead.
# NEVER commit your real .env.

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=

# Server (defaults shown)
# PORT=3000
# HOST=127.0.0.1            # this phone only. Use 0.0.0.0 to allow other devices — then a token is REQUIRED:
# OPENJARVIS_TOKEN=         # if HOST is not loopback and this is empty, a random token is printed at startup
# OPENJARVIS_DATA=./data    # where keys, settings and downloaded models are stored
# OPENJARVIS_MAX_BODY=6291456
# OPENJARVIS_RATE_CHAT=40   # chat requests per minute per client
